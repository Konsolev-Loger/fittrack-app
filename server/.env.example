NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/fittrack
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-another-random-secret-at-least-32-characters
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Keep 0 locally; set only for the verified proxy topology on your host.
TRUST_PROXY_HOPS=0
# Local preview writes private JSON letters to server/.mail-preview (never committed).
APP_URL=http://127.0.0.1:5173
MAIL_MODE=preview
# Production: MAIL_MODE=smtp, APP_URL=https://your-site.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Enable together with client VITE_EMAIL_AUTH_ENABLED when SMTP is ready.
EMAIL_AUTH_ENABLED=false
